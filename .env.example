# -----------------------------------------------------------------------
# Webhook Receiver  (one .env per site deployment)
# -----------------------------------------------------------------------
SITE_CODE=SITE_A                          # Short unique identifier for this site
RABBITMQ_URL=amqp://omd:omd_secret@rabbitmq:5672/
RABBITMQ_EXCHANGE=omd.sync
WEBHOOK_SECRET=                           # Optional; match the secret in OMD Event Subscription
PORT=8080

# -----------------------------------------------------------------------
# Central Consumer  (.env at central host)
# -----------------------------------------------------------------------
# RABBITMQ_URL=amqp://omd:omd_secret@rabbitmq:5672/
# RABBITMQ_EXCHANGE=omd.sync
# RABBITMQ_QUEUE=omd.central.sync
# RABBITMQ_ROUTING_KEY=#                  # "#" = all sites; "SITE_A.#" = one site only
# RABBITMQ_PREFETCH=10
# CENTRAL_OMD_URL=http://central-omd:8585
# CENTRAL_OMD_TOKEN=<jwt-from-central-omd>
# DELETION_STRATEGY=soft_delete           # log | soft_delete | hard_delete
